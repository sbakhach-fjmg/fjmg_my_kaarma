# Copy to .env and fill in with Notepad (not a shell command, which would land in history).
# .env is git-ignored. Never paste these values into chat.
MYKAARMA_USERNAME=
MYKAARMA_PASSWORD=
MYKAARMA_BASE_URL=https://api.mykaarma.com
# SQL Server holding Current_Inventory and the src_mykaarma__* tables (Windows integrated auth, no password)
MSSQL_CONNECTION=Server=<server>;Database=<db>;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes
